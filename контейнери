# --- 3. Словники ---
students = {"Васильєв": 3.5, "Семенов": 4.0, "Петров": 4.5, "Іванов": 3.0, "Мар'їн": 5.0}  #[cite: 2]
print("3. Словники:")
for student in students.keys():
  students.update({student: students[student] + 1 if students[student] + 1 <= 5 else 5.0})  #[cite: 2]
print(students)
print("-" * 40)

